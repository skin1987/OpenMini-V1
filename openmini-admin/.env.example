# OpenMini Admin Environment Variables
# 复制此文件为 .env 并填写实际值
# cp .env.example .env

# JWT Secret (必需 - 生产环境必须使用强随机字符串)
# 生成方式: openssl rand -base64 32
OPENMINI_JWT_SECRET=change-me-in-production-to-random-string

# Server Configuration (可选)
# SERVER_HOST=0.0.0.0
# SERVER_PORT=9000

# Database URL (可选 - 默认使用SQLite)
# DATABASE_URL=sqlite:data/admin.db?mode=rwc

# Upstream API URL (可选)
# UPSTREAM_BASE_URL=http://localhost:8080/api/v1
